{
  "name": "boredkevin-ui-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/showcase",
    "build:ui": "npm run build --workspace=packages/ui",
    "build:showcase": "npm run build --workspace=apps/showcase",
    "build": "npm run build:ui && npm run build:showcase",
    "preview": "npm run preview --workspace=apps/showcase"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  }
}
